# Copy to .env.local and fill in. Never commit real values.

# ---- Mock data ----
# "true" serves built-in demo content instead of Firestore and disables all writes. Example: USE_MOCK_DATA=true
# (Also auto-enabled in development when the Firebase Admin variables below are missing. Never auto-enabled in production.)
USE_MOCK_DATA=

# ---- Firebase client (public; used for admin sign-in only) ----
# Firebase web API key
NEXT_PUBLIC_FIREBASE_API_KEY=
# Firebase auth domain, e.g. <project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Firebase project id
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Firebase storage bucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Firebase messaging sender id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Firebase web app id
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Analytics measurement id (optional)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- Firebase Admin (server-only; all Firestore access goes through this) ----
# Service account project id
FIREBASE_ADMIN_PROJECT_ID=
# Service account client email
FIREBASE_ADMIN_CLIENT_EMAIL=
# Service account private key (keep the \n escapes, wrap in double quotes)
FIREBASE_ADMIN_PRIVATE_KEY=
# Firestore emulator host for local development / pnpm seed:emulator, e.g. 127.0.0.1:8080 (leave empty in production)
FIRESTORE_EMULATOR_HOST=

# ---- Admin access (server-only) ----
# Comma-separated emails that are always superadmins
SUPERADMIN_EMAILS=

# ---- Local admin login (development only) ----
# Sign in to /admin without Firebase while running `pnpm dev`. Ignored by `next build` / `next start`.
# "true" switches the dashboard to the local login
NEXT_PUBLIC_DEV_LOGIN=
# Email to sign in with, e.g. admin@ihsb.local
DEV_ADMIN_EMAIL=
# Password to sign in with (at least 8 characters)
DEV_ADMIN_PASSWORD=

# ---- Google reCAPTCHA v3 ----
# Site key (public) used by the contact and admission forms
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key (server-only); required in production or public form submissions are rejected
RECAPTCHA_SECRET_KEY=
# Minimum accepted score between 0 and 1 (optional, default 0.5)
RECAPTCHA_MIN_SCORE=

# ---- Cloudinary (server-only; use either the URL or the three separate values) ----
# Full URL: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Cloud name (alternative to CLOUDINARY_URL)
CLOUDINARY_CLOUD_NAME=
# API key (alternative to CLOUDINARY_URL)
CLOUDINARY_API_KEY=
# API secret (alternative to CLOUDINARY_URL)
CLOUDINARY_API_SECRET=

# ---- Contact form email (server-only) ----
# Gmail address used to send mail
EMAIL_USER=
# Gmail app password for EMAIL_USER
EMAIL_PASS=
# Inbox that receives contact form messages
CONTACT_TO_EMAIL=

# ---- AI text improvement in the admin dashboard (server-only, optional) ----
# OpenAI API key
OPENAI_API_KEY=
